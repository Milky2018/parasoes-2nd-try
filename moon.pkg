import {
  "Milky2018/tic80",
  "Milky2018/tic80/raw",
  "moonbitlang/core/encoding/ascii",
}

supported_targets = "wasm"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "import-memory": { "module": "env", "name": "memory" },
      "memory-limits": { "min": 4, "max": 4 },
      "heap-start-address": 98304,
    },
  },
)
